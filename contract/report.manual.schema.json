{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soken.dev/schema/report.manual.json",
  "title": "Manual report.json (plan part 08 section 8.3.5); written by Soken engineers, not by the server",
  "description": "Describes what build_report.py reads today in manual mode. Must validate the GBLIN reference (CI test schema-manual-gblin).",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "summary", "scope", "architecture", "roles", "method", "severity_scale", "findings", "review_coverage"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "client", "network", "explorer", "version", "status", "date", "out_name"],
      "properties": {
        "report_type": {"const": "manual"},
        "kind": {"type": "string", "maxLength": 80},
        "client": {"type": "string", "maxLength": 80},
        "client_site": {"type": "string", "maxLength": 120},
        "repo": {"type": "string", "maxLength": 200},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
        "network": {"type": "string", "maxLength": 60},
        "explorer": {"type": "string", "pattern": "^https://[a-z0-9.-]+(/[A-Za-z0-9._~/-]*)?$"},
        "scope_line": {"type": "string", "maxLength": 200},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "status": {"type": "string", "maxLength": 60},
        "date": {"type": "string", "maxLength": 40},
        "footer_line": {"type": "string", "maxLength": 200},
        "out_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,96}\\.pdf$"}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["kpis"],
      "properties": {"kpis": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["value", "label"], "properties": {"value": {"type": ["integer", "number", "string"]}, "label": {"type": "string", "maxLength": 80}}}}}
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["contracts"],
      "properties": {
        "contracts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "file", "nsloc"], "properties": {"name": {"type": "string"}, "file": {"type": "string"}, "nsloc": {"type": "integer", "minimum": 0}, "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"}, "note": {"type": "string"}}}},
        "out_of_scope": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}}
      }
    },
    "architecture": {
      "type": "object", "additionalProperties": false, "required": ["title", "cols", "rows", "nodes", "edges"],
      "properties": {
        "title": {"type": "string"},
        "cols": {"type": "integer", "minimum": 1, "maximum": 8},
        "rows": {"type": "integer", "minimum": 1, "maximum": 8},
        "row_height": {"type": "integer"},
        "nodes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "kind", "col", "row"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "sub": {"type": "string"}, "kind": {"enum": ["actor", "scope", "ext"]}, "col": {"type": "number", "minimum": 0}, "row": {"type": "integer", "minimum": 0}, "span": {"type": "number"}}}},
        "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["a", "b"], "properties": {"a": {"type": "string"}, "b": {"type": "string"}, "label": {"type": "string"}, "both": {"type": "boolean"}, "lpos": {"type": "number"}}}}
      }
    },
    "roles": {
      "type": "object", "additionalProperties": false, "required": ["table"],
      "properties": {"table": {"$ref": "#/$defs/table"}, "notes": {"type": "array", "items": {"$ref": "#/$defs/block"}}}
    },
    "method": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}},
    "severity_scale": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "severity", "title", "component", "category", "status", "location", "body"],
        "properties": {
          "id": {"type": "string", "pattern": "^[CHMLI]-[0-9]{3}$"},
          "severity": {"enum": ["Critical", "High", "Medium", "Low", "Informational"]},
          "title": {"type": "string"},
          "component": {"type": "string"},
          "category": {"type": "string"},
          "status": {"type": "string"},
          "location": {"type": "string"},
          "client_response": {"type": "string"},
          "body": {"type": "array", "items": {"$ref": "#/$defs/block"}}
        }
      }
    },
    "verification": {"type": "array", "items": {"$ref": "#/$defs/block"}},
    "testing": {"type": "object"},
    "review_coverage": {"type": "array", "items": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}}}
  },
  "$defs": {
    "table": {
      "type": "object", "additionalProperties": false, "required": ["head", "rows"],
      "properties": {
        "head": {"type": "array", "items": {"type": "string"}},
        "rows": {"type": "array", "items": {"type": "array", "items": {"type": ["string", "integer", "number"]}}},
        "widths": {"type": "array", "items": {"type": "string", "pattern": "^([0-9]{1,2}%)?$"}},
        "num": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    },
    "block": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["h"], "properties": {"h": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["p"], "properties": {"p": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["ul"], "properties": {"ul": {"type": "array", "items": {"type": "string"}}}},
        {"type": "object", "additionalProperties": false, "required": ["table"], "properties": {"table": {"$ref": "#/$defs/table"}}},
        {"type": "object", "additionalProperties": false, "required": ["chart"], "properties": {"chart": {"type": "object"}}}
      ]
    }
  }
}
