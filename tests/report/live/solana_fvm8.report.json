   "attack_steps": [
    {
     "text": "Borrower repays by transferring USDC into the escrow's loan ATA, which the design treats as repayment; the escrow stays Active until settle credits it.",
     "ref": {
      "path": "src/instructions/escrow_instructions/loan.rs",
      "start": 112,
      "end": 122
     }
    },
    {
     "text": "Lender calls classic SPL Token SetAuthority (AccountOwner) on their own USDC ATA, so the account at the lender ATA address no longer has the lender as owner.",
     "ref": {
      "path": "src/instructions/escrow_instructions/loan.rs",
      "start": 590,
      "end": 597
     }
    },
    {
     "text": "Every settle call now fails the associated_token::authority = lender check and reverts, so the repayment is not credited and the loan stays Active.",
     "ref": {
      "path": "src/instructions/escrow_instructions/loan.rs",
      "start": 613,
      "end": 629
     }
    },
    {
     "text": "While the loan is Active, recipient claims and sweep are rejected, so the borrower's collateral stays locked although the debt is fully paid.",
     "ref": {
      "path": "src/state/vesting_escrow.rs",
      "start": 235,
      "end": 247
     }
    }
   ]
