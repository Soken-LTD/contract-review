 "findings": [
  {
   "id": "I-001",
   "severity": "Informational",
   "evidence_level": "analyzer_and_reasoning",
   "title": "Payable constructor can strand native currency that the contract has no path to release",
   "component": "StandardBEP20",
   "location": {
    "path": "StandardBEP20.sol",
    "start": 843,
    "end": 855
   },
   "category": "Accounting logic",
   "category_key": "evm.accounting_logic",
   "description": [
    {
     "p": "StandardBEP20 declares a payable constructor, and the deployment transaction may carry native currency. In the token-factory template this value is forwarded by the ServicePayer helper to a fee receiver. StandardBEP20 does not inherit ServicePayer and its constructor body only mints the initial balance, which leaves any attached value on the token contract. The token exposes only the standard transfer, allowance and ownership functions; the constructor is the single payable entry, and value that enters there stays for the life of the contract."
    },
    {
     "p": "The deployed instance holds a native balance of {{fact:onchain.balance}}, which shows that the deployment transaction carried nothing. The pattern is therefore a code hygiene point for this deployment rather than a live loss."
    }
   ],
   "impact": [
    {
     "p": "Native currency sent with the deployment transaction would be unrecoverable. For the reviewed instance the balance is zero and nothing is at risk; the point matters for re-deployments of the same source."
    }
   ],
   "recommendation": [
    {
     "ul": [
      "Remove the payable modifier from the StandardBEP20 constructor, or inherit ServicePayer so that the attached value is forwarded as the template intends.",
      "Keep the deployment script free of attached value when the current source is reused on another chain."
     ]
    }
   ],
   "evidence": {
