 "findings": [
  {
   "id": "L-001",
   "severity": "Low",
   "evidence_level": "reasoning_only",
   "title": "The whole initial supply is minted to the deployer account at construction",
   "component": "WallitelliToken",
   "location": {
    "path": "contracts/WallitelliToken.sol",
    "start": 9,
    "end": 11
   },
   "category": "Centralization",
   "category_key": "evm.centralization",
   "description": [
    {
     "p": "The constructor mints the full supply of {fact:onchain.total_supply} token units to msg.sender, the account that sent the deployment transaction. The token exposes only the standard ERC-20 entry points, so the supply is fixed after deployment and the contract itself holds no privileged role. Distribution, vesting and lock-ups, if any, take place outside this contract and cannot be verified from the code."
    }
   ],
   "impact": [
    {
     "p": "At deployment a single externally controlled account holds every token. Holders depend on that account's key management and on off-chain commitments for how the supply is distributed. A compromise or a sale from that account moves the whole supply at once. This is a property of the launch, not a defect in the token logic."
    }
   ],
   "recommendation": [
    {
     "ul": [
      "Publish the distribution plan and move allocations into vesting or lock contracts, or a multisignature treasury, soon after deployment.",
      "Keep the deployer key in a hardware wallet or multisignature account and document which addresses hold team and treasury allocations."
     ]
    }
   ],
   "evidence": {
    "code": [
     {
      "code": {
       "ref": {
        "path": "contracts/WallitelliToken.sol",
        "start": 9,
        "end": 11
       },
       "lines": [
        [
         9,
         "    constructor() ERC20(\"Wallitelli\", \"WALLI\") {"
        ],
        [
         10,
         "        _mint(msg.sender, 1_000_000_000 * 10 ** decimals());"
        ],
        [
         11,
         "    }"
        ]
       ]
      }
     }
    ],
