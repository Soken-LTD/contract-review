# Optional environment for the chain tools (review_chain_read, review_chain_roles, review_chain_balances).
# Everything here is optional and costs nothing: without any of it the tools use the free public pool
# (src/soken_review/chain/data/free_rpc.json plus chains.json) and say in each result what a free source
# capped or failed. Only free-tier keys belong here; never commit real values.

# Free-tier keyed hosts, tried before the free pool (src/soken_review/chain/data/keyed_providers.json names
# the endpoint, auth style and chains of each). A key answered with 401 or 403 cools down for an hour and the
# call falls back to the free pool. Values stay in the host process: never in a container, a log or a result.
# BSC (56):
# SOKEN_KEY_NODEREAL=
# 1, 56, 10, 137, 8453, 42161:
# SOKEN_KEY_DRPC=
# Ethereum (1):
# SOKEN_KEY_INFURA=
# 1, 8453, 42161, 10, 137 (answers from US addresses only):
# SOKEN_KEY_ALCHEMY=
# Solana:
# SOKEN_KEY_HELIUS=
# TRON (header TRON-PRO-API-KEY):
# SOKEN_KEY_TRONGRID=
# TON (header X-API-Key):
# SOKEN_KEY_TONCENTER=
# The older names below stay as aliases.

# Extra RPC URLs for one EVM chain, comma-separated, tried first (for example a free-tier key endpoint).
# SOKEN_CHAIN_RPC_56=
# SOKEN_CHAIN_RPC_1=

# Existing single RPC override used by the pipeline (chain_state); the chain tools try it next.
# SOKEN_RPC_56=

# TronGrid free key (header TRON-PRO-API-KEY). Without it TronGrid allows about 2 calls per second.
# TRON_GRID_API_KEY=

# Solana RPC URL (a free-tier key URL, for example). Default: https://api.mainnet-beta.solana.com
# SOKEN_SOLANA_RPC=

# toncenter free key (header X-API-Key). Without it toncenter allows about 1 call per second.
# SOKEN_TONCENTER_API_KEY=

# Read units per job and per quota key per rolling day (defaults in contract/ops/limits.yaml chain_access).
# SOKEN_CHAIN_JOB_RU=2000
# SOKEN_CHAIN_KEY_RU_PER_DAY=6000
